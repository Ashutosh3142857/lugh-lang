{
  "name": "lugh-lang",
  "version": "0.7.1",
  "description": "Lugh, the programming language for AI agents: check and dry-run programs where policy, budgets and human approval are part of the code. Includes an MCP server.",
  "mcpName": "io.github.Ashutosh3142857/lugh",
  "type": "module",
  "bin": { "lugh-lang": "bin/lugh-lang.mjs" },
  "exports": { ".": "./lib/runtime.mjs", "./mcp": "./lib/mcp.mjs" },
  "files": ["bin/", "lib/", "policies/", "lugh.wasm", "REFERENCE.md", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": { "test": "node test/mcp.test.mjs && node --test --test-timeout=15000 test/guard.test.mjs" },
  "keywords": ["ai-agents", "mcp-proxy", "mcp-guard", "mcp-security", "agents", "mcp", "model-context-protocol", "mcp-server", "programming-language", "guardrails", "human-in-the-loop", "agent-safety", "policy", "webassembly"],
  "homepage": "https://ashutosh3142857.github.io/lugh-lang/",
  "repository": { "type": "git", "url": "git+https://github.com/Ashutosh3142857/lugh-lang.git", "directory": "npm" },
